<model>
    <mount>//OPNsense/InversaPanel</mount>
    <version>1.3.1</version>
    <description>Inversa Panel - easy management</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <language type="OptionField">
                <Default>auto</Default>
                <Required>Y</Required>
                <OptionValues>
                    <auto>Automatic</auto>
                    <tr>Türkçe</tr>
                    <en>English</en>
                    <de>Deutsch</de>
                    <fr>Français</fr>
                    <es>Español</es>
                    <it>Italiano</it>
                </OptionValues>
            </language>
            <!-- internal networks Inversa Panel protects (blocking rules and DNS enforcement apply here) -->
            <interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
                <Default>lan</Default>
                <Required>Y</Required>
                <filters>
                    <enable>/^(?!0).*$/</enable>
                </filters>
            </interfaces>
            <!-- turn on Unbound query statistics (needed for the dashboard counters) -->
            <dnsstats type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </dnsstats>
            <!-- set once the user went through the welcome card; nothing is switched on before that -->
            <welcomed type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </welcomed>
        </general>
        <devices>
            <device type="ArrayField">
                <mac type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/</Mask>
                    <ValidationMessage>Invalid MAC address.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <ValidationMessage>This device already exists.</ValidationMessage>
                            <type>UniqueConstraint</type>
                        </check001>
                    </Constraints>
                </mac>
                <name type="TextField">
                    <Mask>/^[^\x00-\x1f&lt;&gt;"]{0,128}$/</Mask>
                    <ValidationMessage>Invalid device name.</ValidationMessage>
                </name>
                <type type="OptionField">
                    <Default>unknown</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <phone>Phone</phone>
                        <tablet>Tablet</tablet>
                        <laptop>Computer</laptop>
                        <tv>TV</tv>
                        <console>Game console</console>
                        <printer>Printer</printer>
                        <iot>Smart home</iot>
                        <server>Server / NAS</server>
                        <unknown>Other</unknown>
                    </OptionValues>
                </type>
                <blocked type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </blocked>
                <!-- may use networks on which new devices wait for approval (networks.network.approval) -->
                <approved type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </approved>
            </device>
        </devices>
        <filtering>
            <ads type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </ads>
            <malware type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </malware>
            <adult type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </adult>
            <gambling type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </gambling>
            <bypass type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </bypass>
            <safesearch type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </safesearch>
            <forcedns type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </forcedns>
            <apps type="OptionField">
                <Multiple>Y</Multiple>
                <OptionValues>
                    <tiktok>TikTok</tiktok>
                    <instagram>Instagram</instagram>
                    <facebook>Facebook</facebook>
                    <x>X</x>
                    <youtube>YouTube</youtube>
                    <netflix>Netflix</netflix>
                    <twitch>Twitch</twitch>
                    <discord>Discord</discord>
                    <roblox>Roblox</roblox>
                    <steam>Steam</steam>
                    <whatsapp>WhatsApp</whatsapp>
                    <telegram>Telegram</telegram>
                </OptionValues>
            </apps>
            <allowlist type="CSVListField">
                <Mask>/^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>A valid domain must be specified.</ValidationMessage>
            </allowlist>
            <denylist type="CSVListField">
                <Mask>/^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>A valid domain must be specified.</ValidationMessage>
            </denylist>
            <response type="OptionField">
                <Default>zero</Default>
                <Required>Y</Required>
                <OptionValues>
                    <zero>0.0.0.0</zero>
                    <nxdomain>NXDOMAIN</nxdomain>
                </OptionValues>
            </response>
        </filtering>
        <!-- what Inversa Panel knows about each internal network (the interface itself lives in OPNsense) -->
        <networks>
            <network type="ArrayField">
                <interface type="TextField">
                    <Required>Y</Required>
                    <Mask>/^(lan|opt[0-9]{1,3})$/</Mask>
                </interface>
                <!-- earlier versions: the kind of network. Replaced by a colour, isolation and a speed limit per network. -->
                <kind type="OptionField">
                    <Default>home</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <home>Home</home>
                        <iot>IoT</iot>
                        <guest>Guest</guest>
                        <camera>Cameras</camera>
                        <server>Servers</server>
                    </OptionValues>
                </kind>
                <!-- colour of the network in the lists -->
                <color type="TextField">
                    <Mask>/^#[0-9A-Fa-f]{6}$/</Mask>
                </color>
                <!--
                    kept apart from the other networks; which ones it still talks to is in the access
                    rules below (both directions allowed)
                -->
                <isolated type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </isolated>
                <!-- speed limit of the whole network (Mbit/s) -->
                <limit type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </limit>
                <down type="IntegerField">
                    <Default>20</Default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>10000</MaximumValue>
                    <Required>Y</Required>
                </down>
                <up type="IntegerField">
                    <Default>5</Default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>10000</MaximumValue>
                    <Required>Y</Required>
                </up>
                <!-- created by Inversa Panel: only these may be deleted from Inversa Panel -->
                <created type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </created>
                <!-- devices on this network reach nothing but the firewall itself until they are approved -->
                <approval type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </approval>
            </network>
        </networks>
        <!-- access between networks: one entry per (from, to) pair; "wan" means the internet -->
        <access>
            <rule type="ArrayField">
                <from type="TextField">
                    <Required>Y</Required>
                    <Mask>/^(lan|opt[0-9]{1,3})$/</Mask>
                </from>
                <to type="TextField">
                    <Required>Y</Required>
                    <Mask>/^(lan|opt[0-9]{1,3}|wan)$/</Mask>
                </to>
                <allow type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </allow>
            </rule>
        </access>
        <schedules>
            <schedule type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[^\x00-\x1f&lt;&gt;"]{1,64}$/</Mask>
                </name>
                <devices type="CSVListField">
                    <Mask>/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </devices>
                <!-- 1 = Monday ... 7 = Sunday -->
                <days type="CSVListField">
                    <Mask>/^[1-7]$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </days>
                <start type="TextField">
                    <Required>Y</Required>
                    <Default>21:00</Default>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                </start>
                <end type="TextField">
                    <Required>Y</Required>
                    <Default>07:00</Default>
                    <Mask>/^([01][0-9]|2[0-3]):[0-5][0-9]$/</Mask>
                </end>
                <action type="OptionField">
                    <Default>cut</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <cut>Cut internet</cut>
                        <apps>Block apps</apps>
                    </OptionValues>
                </action>
                <apps type="CSVListField">
                    <Mask>/^[a-z0-9]{1,32}$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </apps>
            </schedule>
        </schedules>
        <guest>
            <limit type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </limit>
            <down type="IntegerField">
                <Default>20</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>10000</MaximumValue>
                <Required>Y</Required>
            </down>
            <up type="IntegerField">
                <Default>5</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>10000</MaximumValue>
                <Required>Y</Required>
            </up>
        </guest>
        <geo>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <direction type="OptionField">
                <Default>in</Default>
                <Required>Y</Required>
                <OptionValues>
                    <in>Incoming only</in>
                    <both>Incoming and outgoing</both>
                </OptionValues>
            </direction>
            <countries type="CSVListField">
                <Mask>/^[A-Z]{2}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
            </countries>
            <!--
                block: connections from "countries" are refused.
                allow: only connections from "allowed" get in (incoming only, whatever "direction" says);
                       each mode keeps its own list, so switching back and forth loses nothing.
            -->
            <mode type="OptionField">
                <Default>block</Default>
                <Required>Y</Required>
                <OptionValues>
                    <block>Block the chosen countries</block>
                    <allow>Allow only the chosen countries</allow>
                </OptionValues>
            </mode>
            <allowed type="CSVListField">
                <Mask>/^[A-Z]{2}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
            </allowed>
            <!-- the VPN connections of this firewall can be reached from any country -->
            <vpnexempt type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </vpnexempt>
        </geo>
        <!--
            DNS servers Unbound asks. "auto" leaves Unbound as OPNsense has it; the others are written
            as forward / DNS over TLS entries of Unbound (Services > Unbound DNS), described
            "Inversa Panel (managed)". Local names are Unbound host overrides with that description
            and are not stored here.
        -->
        <dns>
            <upstream type="OptionField">
                <Default>auto</Default>
                <Required>Y</Required>
                <OptionValues>
                    <auto>Automatic (as set in OPNsense)</auto>
                    <cloudflare>Cloudflare</cloudflare>
                    <google>Google</google>
                    <quad9>Quad9</quad9>
                    <adguard>AdGuard DNS</adguard>
                    <custom>Own servers</custom>
                </OptionValues>
            </upstream>
            <!-- own servers -->
            <servers type="NetworkField">
                <NetMaskAllowed>N</NetMaskAllowed>
                <FieldSeparator>,</FieldSeparator>
                <AsList>Y</AsList>
            </servers>
            <!-- encrypt the queries (DNS over TLS) -->
            <dot type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </dot>
            <!-- own servers with DNS over TLS: the name their certificate is checked against -->
            <tlsname type="HostnameField">
                <IsDNSName>Y</IsDNSName>
                <IpAllowed>N</IpAllowed>
            </tlsname>
        </dns>
        <!--
            Attack protection: Suricata (OPNsense's intrusion detection) on the protected networks.
            The service itself, its rulesets and the "drop" policy live in OPNsense's IDS model.
        -->
        <ips>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <mode type="OptionField">
                <Default>detect</Default>
                <Required>Y</Required>
                <OptionValues>
                    <detect>Alert only</detect>
                    <block>Block</block>
                </OptionValues>
            </mode>
            <groups type="OptionField">
                <Multiple>Y</Multiple>
                <Default>malware,attackers,exploits,phishing</Default>
                <OptionValues>
                    <malware>Malware and command servers</malware>
                    <attackers>Known attacker addresses</attackers>
                    <exploits>Exploits of vulnerabilities</exploits>
                    <phishing>Phishing</phishing>
                    <scan>Scans and floods</scan>
                </OptionValues>
            </groups>
        </ips>
        <!-- notifications by Telegram (scripts/.../notify.py, every minute): only sends, never takes commands -->
        <notify>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <token type="TextField">
                <Mask>/^[0-9]{5,20}:[A-Za-z0-9_-]{20,80}$/</Mask>
                <ValidationMessage>This does not look like a bot token (numbers, a colon, then letters and numbers).</ValidationMessage>
            </token>
            <chat type="TextField">
                <Mask>/^(-?[0-9]{1,20}|@[A-Za-z0-9_]{4,64})$/</Mask>
                <ValidationMessage>A chat is a number (it may start with a minus) or a public name starting with @.</ValidationMessage>
            </chat>
            <devices type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </devices>
            <attacks type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </attacks>
            <vpn type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </vpn>
            <internet type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </internet>
            <logins type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </logins>
            <updates type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </updates>
        </notify>
        <!--
            VPN connections Inversa Panel manages. A WireGuard one (remote access or site to site) refers to
            its instance in OPNsense's WireGuard models (keys, port, tunnel, peers) by uuid in "server";
            an IPsec one (site to site) refers to its connection in OPNsense's IPsec models in "ipsec".
        -->
        <vpns>
            <connection type="ArrayField">
                <server type="TextField">
                    <Mask>/^[0-9a-f-]{36}$/</Mask>
                </server>
                <ipsec type="TextField">
                    <Mask>/^[0-9a-f-]{36}$/</Mask>
                </ipsec>
                <kind type="OptionField">
                    <Default>remote</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <remote>Remote access</remote>
                        <site>Site to site</site>
                    </OptionValues>
                </kind>
                <!-- internal networks (interface keys) reachable through this connection -->
                <networks type="CSVListField">
                    <Mask>/^(lan|opt[0-9]{1,3})$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </networks>
                <!-- remote access: full = all traffic through home, split = selected networks only -->
                <mode type="OptionField">
                    <Default>split</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <full>All traffic</full>
                        <split>Selected networks only</split>
                    </OptionValues>
                </mode>
                <!-- address the other end uses to reach this firewall (remote access devices, IPsec); empty = current WAN address -->
                <endpoint type="HostnameField">
                    <IpAllowed>Y</IpAllowed>
                </endpoint>
                <!-- site to site: networks behind the other side -->
                <remote_networks type="CSVListField">
                    <Mask>/^[0-9a-fA-F.:]+\/[0-9]{1,3}$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </remote_networks>
            </connection>
            <!--
                remote access devices (WireGuard peers) that may reach certain addresses only; a device
                without an entry reaches what its connection reaches. targets: address or address:port
            -->
            <access type="ArrayField">
                <peer type="TextField">
                    <Mask>/^[0-9a-f-]{36}$/</Mask>
                    <Required>Y</Required>
                </peer>
                <targets type="CSVListField">
                    <Mask>/^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?$/</Mask>
                    <MaskPerItem>Y</MaskPerItem>
                </targets>
                <dns type="BooleanField">
                    <Default>1</Default>
                </dns>
            </access>
        </vpns>
        <logs>
            <!-- the internet history page: off unless somebody wants it, and only for these networks -->
            <history type="BooleanField">
                <Default>0</Default>
            </history>
            <networks type="CSVListField">
                <Mask>/^(lan|opt[0-9]{1,3})$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
            </networks>
            <!-- addresses from the internet that are refused (chosen on the attacks page) -->
            <blocked type="CSVListField">
                <Mask>/^[0-9a-fA-F.:]{3,45}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
            </blocked>
        </logs>
        <vpn>
            <!-- 0.2 single-instance settings, migrated into vpns.connection on first use -->
            <!-- full: all client traffic through home (ad blocking on the road); split: only home networks -->
            <mode type="OptionField">
                <Default>full</Default>
                <Required>Y</Required>
                <OptionValues>
                    <full>All traffic</full>
                    <split>Home networks only</split>
                </OptionValues>
            </mode>
            <!-- address phones use to reach home (public IP or DynDNS name); empty = current WAN address -->
            <endpoint type="HostnameField">
                <IpAllowed>Y</IpAllowed>
            </endpoint>
        </vpn>
    </items>
</model>
