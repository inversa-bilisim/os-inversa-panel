rm -f /tmp/opnsense_menu_cache.xml /tmp/opnsense_acl_cache.json /var/lib/php/tmp/opnsense_menu_cache.xml /var/lib/php/tmp/opnsense_acl_cache.json
if [ -z "${PKG_UPGRADE}" ]; then
    # the panel's own records (data usage, events, logs) go with the package;
    # what it wrote into the OPNsense configuration stays until it is removed there
    rm -rf /var/db/inversapanel /var/db/inversapanel-update
    # the device identity watch's lease script for dnsmasq goes with the package
    if [ -f /usr/local/etc/dnsmasq.conf.d/inversapanel.conf ]; then
        rm -f /usr/local/etc/dnsmasq.conf.d/inversapanel.conf
        /usr/local/sbin/configctl dnsmasq restart > /dev/null 2>&1 || true
    fi
    # users who chose the panel as the page after logging in would land on a page that is gone
    if [ -f /usr/local/opnsense/mvc/script/load_phalcon.php ]; then
        /usr/local/bin/php -r 'require_once "/usr/local/opnsense/mvc/script/load_phalcon.php"; $m = new \OPNsense\Auth\User(); $n = 0; foreach ($m->user->iterateItems() as $u) { if ((string)$u->landing_page === "/ui/inversapanel") { $u->landing_page = ""; $n++; } } if ($n > 0) { $m->serializeToConfig(false, true); \OPNsense\Core\Config::getInstance()->save(); }' > /dev/null 2>&1 || true
    fi
    if [ -x /usr/local/sbin/configctl ]; then
        /usr/local/sbin/configctl cron restart > /dev/null 2>&1 || true
        # the panel's firewall rules end with the package
        /usr/local/sbin/configctl filter reload > /dev/null 2>&1 || true
    fi
fi
